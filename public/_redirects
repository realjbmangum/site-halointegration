# /redesign/* was a live, crawlable duplicate of the whole site between
# March and October 2026. The route tree is deleted; send anything that was
# indexed or shared to the real equivalent rather than a 404.
#
# Each path is listed twice on purpose: a /*-splat rule does not match the
# slashless form, and with trailingSlash:true nothing redirects bare -> slash
# once the directory no longer exists.
/redesign                              /              301
/redesign/*                            /              301
/redesign/services                     /services/     301
/redesign/services/*                   /services/     301
/redesign/projects                     /projects/     301
/redesign/projects/*                   /projects/     301
/redesign/contact                      /contact/      301
/redesign/contact/*                    /contact/      301
/redesign/about                        /about/        301
/redesign/about/*                      /about/        301

# digital-solutions and infrastructure-consulting were pre-redesign pages
# superseded by the real service pages. Deleted October 2026.
/services/digital-solutions            /services/structured-cabling/    301
/services/digital-solutions/*          /services/structured-cabling/    301
/services/infrastructure-consulting    /services/prop-tech-consulting/  301
/services/infrastructure-consulting/*  /services/prop-tech-consulting/  301
